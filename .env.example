# Set to "production" on real deployments — enables fail-fast checks on
# secrets, JWT_SECRET length, and CORS configuration.
APP_ENV=development

DATABASE_URL=postgresql+asyncpg://petfeed:petfeed@localhost:5432/petfeed
REDIS_URL=redis://localhost:6379/0
TELEGRAM_BOT_TOKEN=your_bot_token_here
BACKEND_URL=http://localhost:8000
ADMIN_TOKEN=change_me_in_production
DEEPSEEK_API_KEY=your_deepseek_key_here

# --- Mini App ---
# Generate JWT_SECRET with: python3 -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=change-me-in-production
JWT_ALGORITHM=HS256
MINIAPP_URL=https://your-miniapp.railway.app
# Comma-separated allowed CORS origins. Required when ENV=production.
ALLOWED_ORIGINS=https://your-miniapp.railway.app

# --- Observability ---
# Leave empty to disable Sentry (default in development).
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
